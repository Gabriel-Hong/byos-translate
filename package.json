{
  "name": "byos-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Bring your own subscription: bilingual web page translation for Chrome/Edge through your local Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabriel-Hong/byos-translate.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install-host": "node scripts/install-host.mjs",
    "uninstall-host": "node scripts/install-host.mjs --uninstall",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e:chrome": "node scripts/e2e-chrome.mjs",
    "try:chrome": "node scripts/e2e-chrome.mjs --interactive"
  }
